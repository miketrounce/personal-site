---
import Base from "../../layouts/Base.astro";
import { topics } from "../../data/academy-topics";

export function getStaticPaths() {
  return topics.map((topic, index) => ({
    params: { slug: topic.slug },
    props: {
      topic,
      nextTopic: index < topics.length - 1 ? topics[index + 1] : null,
    },
  }));
}

const { topic, nextTopic } = Astro.props;
---

<Base title={`${topic.title} | Quantamental Academy`} description={topic.description}>

  <article class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-6">

      <!-- Back link -->
      <a href="/academy" class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent-indigo transition-colors mb-10">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Academy
      </a>

      <!-- Header -->
      <div class="mb-12 reveal">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`text-xs font-mono font-medium text-${topic.categoryColor} bg-${topic.categoryColor}/10 border border-${topic.categoryColor}/20 px-2.5 py-1 rounded-md`}>
            {topic.category}
          </span>
          <span class="text-xs text-text-secondary font-mono">
            {topic.lessons} lessons
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4">
          {topic.title}
        </h1>
        <p class="text-lg text-text-secondary leading-relaxed max-w-3xl">
          {topic.description}
        </p>
      </div>

      <div class="gradient-line mb-12"></div>

      <!-- Content grid: sidebar + article -->
      <div class="lg:grid lg:grid-cols-[240px_1fr] lg:gap-12">

        <!-- Table of Contents (sticky sidebar) -->
        <aside class="hidden lg:block">
          <nav class="sticky top-24">
            <h4 class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-4">Contents</h4>
            <ul class="space-y-2 border-l border-border pl-4">
              {topic.tableOfContents.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block text-sm text-text-secondary hover:text-accent-indigo transition-colors py-0.5 toc-link"
                    data-section={item.id}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Mobile TOC -->
        <details class="lg:hidden mb-8 rounded-xl border border-border bg-bg-secondary p-4">
          <summary class="text-sm font-semibold cursor-pointer text-text-secondary hover:text-text-primary transition-colors">
            Table of Contents
          </summary>
          <ul class="mt-3 space-y-2 pl-4 border-l border-border">
            {topic.tableOfContents.map((item) => (
              <li>
                <a href={`#${item.id}`} class="block text-sm text-text-secondary hover:text-accent-indigo transition-colors py-0.5">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>

        <!-- Article body -->
        <div class="prose reveal" set:html={topic.content} />
      </div>

      <!-- Next topic -->
      {nextTopic && (
        <div class="mt-20 pt-12 border-t border-border reveal">
          <span class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-4 block">Next Topic</span>
          <a href={`/academy/${nextTopic.slug}`} class="group flex items-center justify-between gap-4 rounded-xl border border-border bg-bg-secondary p-6 card-glow transition-all">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class={`text-xs font-mono text-${nextTopic.categoryColor}`}>{nextTopic.category}</span>
                <span class="text-xs text-text-secondary font-mono">&middot; {nextTopic.lessons} lessons</span>
              </div>
              <h3 class="text-lg font-semibold group-hover:text-accent-indigo transition-colors">
                {nextTopic.title}
              </h3>
            </div>
            <svg class="h-5 w-5 text-text-secondary group-hover:text-accent-indigo transition-colors shrink-0" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      )}

      <!-- Back to Academy (bottom) -->
      {!nextTopic && (
        <div class="mt-20 pt-12 border-t border-border text-center reveal">
          <p class="text-text-secondary mb-4">You've reached the end of the curriculum.</p>
          <a href="/academy" class="inline-flex items-center gap-2 text-accent-indigo font-medium hover:underline">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
              <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to Academy
          </a>
        </div>
      )}
    </div>
  </article>
</Base>

<!-- Active TOC highlighting -->
<script>
  const tocLinks = document.querySelectorAll('.toc-link');
  const sections = Array.from(tocLinks).map((link) => {
    const id = link.getAttribute('data-section');
    return id ? document.getElementById(id) : null;
  }).filter(Boolean) as HTMLElement[];

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = document.querySelector(`.toc-link[data-section="${entry.target.id}"]`);
          if (link) {
            if (entry.isIntersecting) {
              tocLinks.forEach((l) => l.classList.remove('text-accent-indigo', '!text-accent-indigo'));
              link.classList.add('!text-accent-indigo');
            }
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
