---
import Base from "../layouts/Base.astro";
---

<Base title="Contact Macrosynergy | Request a Demo" description="Get in touch with Macrosynergy. Request a demo of JPMaQS data, explore research partnerships, or ask us anything.">

  <!-- Hero -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0">
      <div class="absolute top-1/3 left-1/3 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-accent mb-4 block reveal">Contact</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 reveal">
        Get in Touch
      </h1>
      <p class="mx-auto max-w-2xl text-text-secondary text-lg sm:text-xl leading-relaxed reveal">
        Request a demo, explore a research partnership, or simply ask us a question. We typically respond within one business day.
      </p>
    </div>
  </section>

  <!-- Two-column layout -->
  <section class="pb-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Form (left, 3 cols) -->
        <div class="lg:col-span-3 reveal">
          <form class="space-y-6" id="contact-form">
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-medium mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your full name"
                class="w-full rounded-lg border border-border bg-bg-secondary px-4 py-3 text-sm text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@organization.com"
                class="w-full rounded-lg border border-border bg-bg-secondary px-4 py-3 text-sm text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
              />
            </div>

            <!-- Organization -->
            <div>
              <label for="organization" class="block text-sm font-medium mb-2">Organization</label>
              <input
                type="text"
                id="organization"
                name="organization"
                placeholder="Your company or institution"
                class="w-full rounded-lg border border-border bg-bg-secondary px-4 py-3 text-sm text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
              />
            </div>

            <!-- Interest dropdown -->
            <div>
              <label for="interest" class="block text-sm font-medium mb-2">I'm interested in...</label>
              <select
                id="interest"
                name="interest"
                required
                class="w-full rounded-lg border border-border bg-bg-secondary px-4 py-3 text-sm text-text-primary focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors appearance-none"
                style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2212%22%20height%3D%228%22%20viewBox%3D%220%200%2012%208%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cpath%20d%3D%22M1%201.5L6%206.5L11%201.5%22%20stroke%3D%22%2394a3b8%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 1rem center;"
              >
                <option value="" disabled selected class="text-text-secondary/50">Select a topic</option>
                <option value="jpmaqs">JPMaQS Data</option>
                <option value="research">Research Partnership</option>
                <option value="general">General Inquiry</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-medium mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell us about your needs or questions..."
                class="w-full rounded-lg border border-border bg-bg-secondary px-4 py-3 text-sm text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-base font-semibold text-bg-primary transition-all hover:bg-accent/90 hover:shadow-lg hover:shadow-accent/20"
            >
              Send Message
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Info (right, 2 cols) -->
        <div class="lg:col-span-2 space-y-10 reveal">

          <!-- Office -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-widest text-accent mb-4">Office</h3>
            <div class="space-y-3 text-text-secondary text-sm leading-relaxed">
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-text-secondary/60 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                  <p>Macrosynergy Partners LLP</p>
                  <p>1 Knightsbridge Green</p>
                  <p>London SW1X 7QA</p>
                  <p>United Kingdom</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-widest text-accent mb-4">Email</h3>
            <a href="mailto:info@macrosynergy.com" class="flex items-center gap-3 text-sm text-text-secondary hover:text-accent transition-colors">
              <svg class="h-5 w-5 text-text-secondary/60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              info@macrosynergy.com
            </a>
          </div>

          <!-- LinkedIn -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-widest text-accent mb-4">Connect</h3>
            <a href="https://www.linkedin.com/company/macrosynergy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-text-secondary hover:text-accent transition-colors">
              <svg class="h-5 w-5 text-text-secondary/60 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>

          <!-- What to Expect -->
          <div class="rounded-xl border border-border bg-bg-secondary p-6">
            <h3 class="text-sm font-semibold uppercase tracking-widest text-accent mb-4">What to Expect</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent shrink-0"></div>
                <span>We respond to all inquiries within one business day</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent shrink-0"></div>
                <span>Demo sessions are typically 30 minutes and tailored to your use case</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent shrink-0"></div>
                <span>Research partnership discussions begin with a scoping call to align on objectives</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent shrink-0"></div>
                <span>All data and research shared under NDA upon request</span>
              </li>
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>
</Base>
