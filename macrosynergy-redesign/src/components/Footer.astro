---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: "Research",
    links: [
      { label: "All Research", href: "/research" },
      { label: "Fundamental Value", href: "/research?category=fundamental-value" },
      { label: "Macro Trends", href: "/research?category=macro-trends" },
      { label: "Market Risk", href: "/research?category=market-risk" },
    ],
  },
  {
    title: "Academy",
    links: [
      { label: "Quantamental Academy", href: "/academy" },
      { label: "Indicators on JPMaQS", href: "/academy/indicators-on-jpmaqs" },
      { label: "Trading Strategies", href: "/academy/developing-trading-strategies" },
      { label: "Tutorials", href: "/academy/introductory-tutorials" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About Us", href: "/about" },
      { label: "Careers", href: "/careers" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy Policy", href: "#" },
      { label: "Cookie Policy", href: "#" },
      { label: "Terms of Business", href: "#" },
      { label: "Acceptable Use", href: "#" },
    ],
  },
];
---

<footer class="border-t border-border bg-bg-secondary/50">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <!-- Top section: logo + newsletter -->
    <div class="flex flex-col lg:flex-row justify-between gap-12 mb-16">
      <div class="max-w-md">
        <a href="/" class="inline-block mb-4">
          <img
            src="/images/macrosynergy-logo.png"
            alt="Macrosynergy"
            class="h-6 w-auto brightness-0 invert"
          />
        </a>
        <p class="text-text-secondary text-sm leading-relaxed mb-6">
          Pioneering macro-quantamental data and trading strategies. Transforming real-time macroeconomic data into systematic investment strategies across 40 countries.
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          <a href="https://uk.linkedin.com/company/macrosynergy" target="_blank" rel="noopener" class="flex items-center justify-center h-9 w-9 rounded-lg border border-border text-text-secondary hover:text-accent hover:border-accent/30 transition-colors" aria-label="LinkedIn">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://x.com/macro_synergy" target="_blank" rel="noopener" class="flex items-center justify-center h-9 w-9 rounded-lg border border-border text-text-secondary hover:text-accent hover:border-accent/30 transition-colors" aria-label="X / Twitter">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="max-w-sm">
        <h3 class="text-text-primary font-semibold text-sm mb-2">Weekly Macro Insights</h3>
        <p class="text-text-secondary text-sm mb-4">Get our latest research and market analysis delivered to your inbox.</p>
        <form class="flex gap-2">
          <input
            type="email"
            placeholder="you@institution.com"
            class="flex-1 rounded-lg border border-border bg-bg-primary px-4 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/50 focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/20 transition-colors"
          />
          <button type="submit" class="rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-bg-primary hover:bg-accent/90 transition-colors whitespace-nowrap">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-16">
      {footerSections.map((section) => (
        <div>
          <h3 class="text-text-primary font-semibold text-sm mb-4">{section.title}</h3>
          <ul class="space-y-2.5">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-text-secondary text-sm hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="gradient-line mb-6"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-text-secondary text-xs">
      <p>&copy; {currentYear} Macrosynergy Ltd. All rights reserved.</p>
      <p>London, United Kingdom</p>
    </div>
  </div>
</footer>
