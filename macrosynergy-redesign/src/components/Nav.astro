---
const navLinks = [
  {
    label: "Research",
    href: "/research",
    children: [
      { label: "All Research", href: "/research" },
      { label: "Fundamental Value Estimates", href: "/research?category=fundamental-value" },
      { label: "Macro Trends", href: "/research?category=macro-trends" },
      { label: "Implicit Subsidies", href: "/research?category=implicit-subsidies" },
      { label: "Endogenous Market Risk", href: "/research?category=market-risk" },
      { label: "Price Distortions", href: "/research?category=price-distortions" },
    ],
  },
  {
    label: "Academy",
    href: "/academy",
    children: [
      { label: "Quantamental Academy", href: "/academy" },
      { label: "Macro-Quantamental Indicators", href: "/academy/what-are-quantamental-indicators" },
      { label: "Developing Trading Strategies", href: "/academy/developing-trading-strategies" },
      { label: "Statistical Methods & ML", href: "/academy/statistical-methods-ml" },
    ],
  },
  { label: "About", href: "/about" },
  { label: "Careers", href: "/careers" },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg-primary/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <img
        src="/images/macrosynergy-logo.png"
        alt="Macrosynergy"
        class="h-6 w-auto brightness-0 invert"
      />
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <div class="relative group">
          <a
            href={link.href}
            class:list={[
              "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
              currentPath.startsWith(link.href)
                ? "text-accent"
                : "text-text-secondary hover:text-text-primary hover:bg-bg-tertiary",
            ]}
          >
            {link.label}
            {link.children && (
              <svg class="inline-block ml-1 h-3 w-3 opacity-50" viewBox="0 0 12 12" fill="none">
                <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            )}
          </a>
          {link.children && (
            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="bg-bg-secondary border border-border rounded-xl p-2 shadow-2xl min-w-[240px]">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- CTA + Mobile toggle -->
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden sm:inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-bg-primary transition-all hover:bg-accent/90 hover:shadow-lg hover:shadow-accent/20"
      >
        Request Demo
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-bg-primary/95 backdrop-blur-xl">
    <div class="px-6 py-4 space-y-1">
      {navLinks.map((link) => (
        <>
          <a
            href={link.href}
            class="block px-3 py-2 rounded-lg text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-tertiary transition-colors"
          >
            {link.label}
          </a>
          {link.children?.map((child) => (
            <a
              href={child.href}
              class="block px-6 py-1.5 text-sm text-text-secondary/70 hover:text-text-primary transition-colors"
            >
              {child.label}
            </a>
          ))}
        </>
      ))}
      <div class="pt-3">
        <a
          href="/contact"
          class="block w-full rounded-lg bg-accent px-4 py-2.5 text-center text-sm font-semibold text-bg-primary"
        >
          Request Demo
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
