---
import type { TimelineEntry } from '../data/timeline';

interface Props {
  items: TimelineEntry[];
}

const { items } = Astro.props;
---

<div class="timeline">
  {items.map((item) => (
    <div class:list={['timeline-item', { now: item.current }]}>
      <p class="timeline-dates">{item.dates}</p>
      <p class="timeline-role">{item.role}</p>
    </div>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    padding: 0 0 0 32px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding: 0 0 32px;
    opacity: 0;
    transform: translateY(16px);
    animation: fadeInUp 0.5s ease forwards;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
    border: 2px solid #2f2c28;
  }

  .timeline-item.now::before {
    background: var(--accent);
    box-shadow: 0 0 8px rgba(129, 182, 76, 0.5);
  }

  .timeline-dates {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .timeline-role {
    font-size: 1.1rem;
    color: var(--text);
    font-weight: 600;
    margin: 2px 0 0;
  }

  .timeline-item.now .timeline-role {
    color: var(--accent);
  }

  .timeline-item:nth-child(1) { animation-delay: 0.3s; }
  .timeline-item:nth-child(2) { animation-delay: 0.7s; }
  .timeline-item:nth-child(3) { animation-delay: 1.1s; }
  .timeline-item:nth-child(4) { animation-delay: 1.5s; }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .timeline-item { padding-bottom: 20px; }
    .timeline-dates { font-size: 0.7rem; }
    .timeline-role { font-size: 0.95rem; }
  }
</style>
