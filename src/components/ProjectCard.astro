---
import type { Project } from '../data/projects';

type Props = Project;

const { name, description } = Astro.props;
---

<div class="project">
  <p class="project-name">{name}</p>
  <p class="project-description">{description}</p>
</div>

<style>
  .project {
    padding: 0 0 28px;
  }

  .project:last-child {
    padding-bottom: 0;
  }

  .project-name {
    font-size: 1.1rem;
    color: var(--text);
    font-weight: 700;
    margin: 0 0 4px;
  }

  .project-description {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
