---
export interface LabeledItem {
  label: string;
  description: string;
}
interface Props { items: LabeledItem[]; }
const { items } = Astro.props;
---
<div class="labeled-list">
  {items.map((item) => (
    <div class="labeled-item">
      <p class="labeled-label">{item.label}</p>
      <p class="labeled-description">{item.description}</p>
    </div>
  ))}
</div>
<style>
  .labeled-item { padding: 0 0 28px; }
  .labeled-item:last-child { padding-bottom: 0; }
  .labeled-label {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .labeled-description {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
    max-width: 52ch;
  }
</style>
