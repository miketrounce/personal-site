---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Mike Trounce">
  <div class="contact">
    <h1>Contact</h1>
    <a class="email" href="mailto:trounceflow@gmail.com">trounceflow@gmail.com</a>
  </div>
</Layout>

<style>
  .contact h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--text);
    margin: 0 0 24px;
  }

  .contact .email {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }

  .contact .email:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact h1 {
      font-size: 1.5rem;
      margin-bottom: 16px;
    }
  }
</style>
