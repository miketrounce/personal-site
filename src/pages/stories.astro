---
import Layout from '../layouts/Layout.astro';
import '../styles/page-layouts.css';

const studies = [
  { title: 'The Greensman', desc: 'A garden business paying £125 a year for a website with the wrong address on its own flyer — plus a video that turned a £100 quote into £300, and a YouTube channel in the works.', href: '/the-greensman' },
  { title: 'Trounceflow', href: null },
  { title: 'Delphos IQ', href: null },
  { title: 'Exante Data FlowPro', href: null },
];
---

<Layout
title="Stories — Mike Trounce"
description="Real examples of the work — what was wrong, what changed, and why."
>
<div class="options-page">
<a href="/" class="back-link">&larr; Mike Trounce</a>

<h1>Stories</h1>

<ul class="cs-list">
{studies.map((s) => (
<li class="cs-item">
{s.href
  ? <a href={s.href}>{s.title}</a>
  : <span class="cs-title-plain">{s.title}</span>}
{s.desc && <p>{s.desc}</p>}
{!s.href && <p class="cs-on-request">Details on request &mdash; <a href="mailto:trounceflow@gmail.com">get in touch</a></p>}
</li>
))}
</ul>
</div>
</Layout>

<style>
.cs-list {
list-style: none;
margin: 0;
padding: 0;
border-top: 1px solid var(--line);
}

.cs-item {
padding: 1.5rem 0;
border-bottom: 1px solid var(--line);
}

.cs-item a {
font-family: 'Space Grotesk', system-ui, sans-serif;
font-size: 1.4rem;
color: var(--ink);
text-decoration: none;
border-bottom: 1px solid var(--illus-a);
}

.cs-item a:hover {
color: var(--green);
}

.cs-item p {
margin: 0.5rem 0 0;
color: var(--ink-soft);
font-size: 0.98rem;
}

.cs-title-plain {
font-family: 'Space Grotesk', system-ui, sans-serif;
font-size: 1.4rem;
color: var(--ink);
}

.cs-on-request {
font-size: 0.85rem;
color: var(--ink-faint);
}

.cs-on-request a {
color: var(--ink-faint);
}

.cs-on-request a:hover {
color: var(--accent);
}
</style>
