---
import Layout from '../layouts/Layout.astro';
import '../styles/page-layouts.css';

const studies = [
  { title: 'The Greensman', desc: 'A garden business paying £125 a year for a website with the wrong address on its own flyer.', href: '/story-1' },
  { title: 'This website', desc: 'The general approach behind miketrounce.com itself — one clear job, built plainly.', href: '/story-2' },
];
---

<Layout
title="Stories — Mike Trounce"
description="Real examples of the work — what was wrong, what changed, and why."
>
<div class="options-page">
<a href="/" class="back-link">&larr; Mike Trounce</a>

<h1>Stories</h1>

<ul class="cs-list">
{studies.map((s) => (
<li class="cs-item">
<a href={s.href}>{s.title}</a>
<p>{s.desc}</p>
</li>
))}
</ul>
</div>
</Layout>

<style>
.cs-list {
list-style: none;
margin: 0;
padding: 0;
border-top: 1px solid var(--line);
}

.cs-item {
padding: 1.5rem 0;
border-bottom: 1px solid var(--line);
}

.cs-item a {
font-family: 'Fraunces', Georgia, serif;
font-size: 1.4rem;
color: var(--ink);
text-decoration: none;
border-bottom: 1px solid var(--illus-a);
}

.cs-item a:hover {
color: var(--green);
}

.cs-item p {
margin: 0.5rem 0 0;
color: var(--ink-soft);
font-size: 0.98rem;
}
</style>
