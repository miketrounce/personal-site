---
import Layout from '../layouts/Layout.astro';
import '../styles/page-layouts.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import data from '../data/family.json';

// The site is public, so living people are published without dates or notes.
interface Person {
  id: string;
  name: string;
  born?: string;
  died?: string;
  notes?: string;
  living?: boolean;
  check?: boolean;
  photo?: boolean;
  parents?: string[];
  partners?: string[];
}
interface Unit {
  members: Person[];
  children: Unit[];
  width: number;
  cx: number;
  depth: number;
}

const people: Person[] = (data.people as Person[]).map((p) =>
  p.living ? { id: p.id, name: p.name, living: true, check: p.check, parents: p.parents, partners: p.partners } : p
);
// The chart writes a married-in surname in capitals (e.g. Chris WILSON), which is also the
// surname the bloodline woman goes by, and her children carry. Show it on everyone it applies to.
const capsSurname = (name: string) => name.match(/\b(?:Mc)?[A-Z]{2,}\b/)?.[0];
const hasSurname = (name: string) => name.replace(/\(.*?\)/g, '').trim().split(/\s+/).length > 1;
{
  const raw = new Map<string, Person>(people.map((p) => [p.id, p]));
  const bornOf = new Map<string, string | undefined>((data.people as Person[]).map((p) => [p.id, p.born]));
  const surnames = new Map<string, string>();
  for (const p of people) {
    if (hasSurname(p.name)) continue;
    const viaPartner = [...(p.partners ?? [])].reverse().map((id) => capsSurname(raw.get(id)?.name ?? '')).find(Boolean);
    // Children born 2008 or later (or with no year) stay first-name only.
    const born = bornOf.get(p.id);
    const adult = born && Number(born) < 2008;
    const viaParent = adult && !p.partners?.length ? (p.parents ?? []).map((id) => capsSurname(raw.get(id)?.name ?? '')).find(Boolean) : undefined;
    const surname = viaPartner ?? viaParent;
    if (surname) surnames.set(p.id, surname);
  }
  for (const p of people) if (surnames.has(p.id)) p.name = `${p.name} ${surnames.get(p.id)}`;
}
// A photo is picked up automatically if public/family/<id>.jpg exists.
for (const p of people) {
  if (existsSync(join(process.cwd(), 'public', 'family', `${p.id}.jpg`))) p.photo = true;
}
const initials = (name: string) => {
  const words = name.replace(/\(.*?\)/g, '').trim().split(/\s+/);
  return (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase();
};
const byId = new Map<string, Person>(people.map((p) => [p.id, p]));

const NODE_W = 230;
const NODE_H = 54;
const PAIR_GAP = 12;
const SIB_GAP = 28;
const ROW_GAP = 80;

// A unit is one person, or a couple drawn side by side. The member with
// recorded parents is the "primary", which decides where the unit hangs.
const unitOf = new Map<string, Unit>();
const units: Unit[] = [];
for (const p of people) {
  if (unitOf.has(p.id)) continue;
  const partner = byId.get(p.partners?.[0] ?? '');
  const spouse = partner && !unitOf.has(partner.id) ? partner : undefined;
  const members = spouse && !p.parents && spouse.parents ? [spouse, p] : spouse ? [p, spouse] : [p];
  const unit: Unit = { members, children: [], width: 0, cx: 0, depth: 0 };
  units.push(unit);
  members.forEach((m) => unitOf.set(m.id, unit));
}
const roots: Unit[] = [];
for (const u of units) {
  const parent = unitOf.get(u.members[0].parents?.[0] ?? '');
  if (parent) parent.children.push(u);
  else roots.push(u);
}

const ownWidth = (u: Unit) => u.members.length * NODE_W + (u.members.length - 1) * PAIR_GAP;
function measure(u: Unit) {
  u.children.forEach(measure);
  const kids = u.children.reduce((sum, c) => sum + c.width, 0) + Math.max(0, u.children.length - 1) * SIB_GAP;
  u.width = Math.max(ownWidth(u), kids);
}
function place(u: Unit, left: number, depth: number) {
  u.depth = depth;
  u.cx = left + u.width / 2;
  let x = left + (u.width - (u.children.reduce((s, c) => s + c.width, 0) + Math.max(0, u.children.length - 1) * SIB_GAP)) / 2;
  for (const c of u.children) {
    place(c, x, depth + 1);
    x += c.width + SIB_GAP;
  }
}
const size = (u: Unit): number => 1 + u.children.reduce((n, c) => n + size(c), 0);
roots.sort((a, b) => size(b) - size(a));
let cursor = 0;
for (const r of roots) {
  measure(r);
  place(r, cursor, 0);
  cursor += r.width + SIB_GAP * 2;
}

const PAD = 40;
const nodes: { p: Person; x: number; y: number }[] = [];
const links: string[] = [];
for (const u of units) {
  const y = PAD + u.depth * (NODE_H + ROW_GAP);
  const left = PAD + u.cx - ownWidth(u) / 2;
  u.members.forEach((m, i) => {
    nodes.push({ p: m, x: left + i * (NODE_W + PAIR_GAP), y });
  });
  if (u.members.length === 2) {
    links.push(`M${left + NODE_W} ${y + NODE_H / 2}H${left + NODE_W + PAIR_GAP}`);
  }
  if (u.children.length) {
    const fromY = y + NODE_H / 2;
    const busY = y + NODE_H + ROW_GAP / 2;
    const cxs = u.children.map((c) => PAD + c.cx);
    const jointX = PAD + u.cx;
    links.push(`M${jointX} ${u.members.length === 2 ? fromY : y + NODE_H}V${busY}`);
    links.push(`M${Math.min(jointX, ...cxs)} ${busY}H${Math.max(jointX, ...cxs)}`);
    for (const c of u.children) {
      links.push(`M${PAD + c.cx} ${busY}V${PAD + c.depth * (NODE_H + ROW_GAP)}`);
    }
  }
}
const focusX = PAD + roots[0].cx;
const width = PAD * 2 + Math.max(...units.map((u) => u.cx + u.width / 2));
const height = PAD * 2 + (Math.max(...units.map((u) => u.depth)) + 1) * NODE_H + Math.max(...units.map((u) => u.depth)) * ROW_GAP;
const lifespan = (p: Person) => (p.living ? '' : [p.born, p.died].filter(Boolean).join('–'));
---

<Layout
title="Family tree — Mike Trounce"
description="A searchable family tree."
>
<div class="tree-page">
<a href="/stories/" class="back-link">&larr; Stories</a>
<h1>Family tree</h1>
<p class="placeholder-note">Work in progress, put together from photos of a hand-drawn chart. Some names and links may be wrong or missing, and a few branches aren't connected yet.</p>

<div class="tree-tools">
<label class="visually-hidden" for="tree-search">Search for a person</label>
<input id="tree-search" type="search" placeholder="Search by name" autocomplete="off" />
<ul id="tree-results" class="results" hidden></ul>
</div>

<div class="tree-body">
<div class="tree-wrap">
<svg id="tree" viewBox={`0 0 ${width} ${height}`} role="group" aria-label="Family tree diagram" data-w={width} data-h={height} data-fx={focusX}>
<g class="links">
{links.map((d) => <path d={d} />)}
</g>
{nodes.map(({ p, x, y }) => (
<g class="node" data-id={p.id} transform={`translate(${x} ${y})`} tabindex="0" role="button" aria-label={p.name}>
<rect width={NODE_W} height={NODE_H} rx="8" />
{p.photo ? (
<>
<clipPath id={`clip-${p.id}`}><circle cx="27" cy="27" r="19" /></clipPath>
<image href={`/family/${p.id}.jpg`} x="8" y="8" width="38" height="38" clip-path={`url(#clip-${p.id})`} preserveAspectRatio="xMidYMid slice" />
</>
) : (
<>
<circle class="avatar" cx="27" cy="27" r="19" />
<text class="initials" x="27" y="32" text-anchor="middle">{initials(p.name)}</text>
</>
)}
<text x="54" y={lifespan(p) ? 24 : 32} class="name">{p.name}</text>
{lifespan(p) && <text x="54" y="41" class="dates">{lifespan(p)}</text>}
</g>
))}
</svg>
<div class="zoom-controls">
<button type="button" data-zoom="in" aria-label="Zoom in">+</button>
<button type="button" data-zoom="out" aria-label="Zoom out">&minus;</button>
<button type="button" data-zoom="fit" aria-label="Show whole tree">Fit</button>
</div>
</div>

<aside id="details" class="details" aria-live="polite">
<p class="hint">Drag to move around, scroll or pinch to zoom, and click a person for details.</p>
</aside>
</div>

<script type="application/json" id="family-data" set:html={JSON.stringify(people)} />
</div>
</Layout>

<script>
const people = JSON.parse(document.getElementById('family-data')!.textContent!);
const byId = new Map<string, any>(people.map((p: any) => [p.id, p]));
const svg = document.getElementById('tree') as unknown as SVGSVGElement;
const fullW = Number(svg.dataset.w);
const fullH = Number(svg.dataset.h);
const focusX = Number(svg.dataset.fx);
const details = document.getElementById('details')!;
const input = document.getElementById('tree-search') as HTMLInputElement;
const results = document.getElementById('tree-results')!;

// --- view (pan / zoom) ---
let view = { x: 0, y: 0, w: fullW, h: fullH };
const apply = () => svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.w} ${view.h}`);
const fit = () => {
  view = { x: 0, y: 0, w: fullW, h: fullH };
  const r = svg.getBoundingClientRect();
  const ratio = r.width / r.height;
  if (fullW / fullH < ratio) { view.w = fullH * ratio; view.x = (fullW - view.w) / 2; }
  else { view.h = fullW / ratio; view.y = (fullH - view.h) / 2; }
  apply();
};
// On narrow screens "whole tree" is unreadably small, so start zoomed in on the top of the tree.
const MIN_SCALE = 0.7;
const start = () => {
  fit();
  const r = svg.getBoundingClientRect();
  if (r.width / view.w >= MIN_SCALE) return;
  const w = r.width / MIN_SCALE;
  const h = (w * r.height) / r.width;
  view = { x: Math.max(0, Math.min(focusX - w / 2, fullW - w)), y: 0, w, h };
  apply();
};
const zoomAt = (factor: number, cx: number, cy: number) => {
  const nw = Math.min(Math.max(view.w * factor, 200), fullW * 3);
  const f = nw / view.w;
  view = { x: cx - (cx - view.x) * f, y: cy - (cy - view.y) * f, w: nw, h: view.h * f };
  apply();
};
const toSvg = (clientX: number, clientY: number) => {
  const r = svg.getBoundingClientRect();
  return { x: view.x + ((clientX - r.left) / r.width) * view.w, y: view.y + ((clientY - r.top) / r.height) * view.h };
};

const pointers = new Map<number, { x: number; y: number }>();
let moved = 0;
let pinchDist = 0;
svg.addEventListener('pointerdown', (e) => {
  pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
  moved = 0;
  if (pointers.size === 2) {
    const [a, b] = [...pointers.values()];
    pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
  }
});
svg.addEventListener('pointermove', (e) => {
  const prev = pointers.get(e.pointerId);
  if (!prev) return;
  const cur = { x: e.clientX, y: e.clientY };
  pointers.set(e.pointerId, cur);
  moved += Math.abs(cur.x - prev.x) + Math.abs(cur.y - prev.y);
  if (moved > 6 && !svg.hasPointerCapture(e.pointerId)) svg.setPointerCapture(e.pointerId);
  if (pointers.size === 1) {
    const r = svg.getBoundingClientRect();
    view.x -= ((cur.x - prev.x) / r.width) * view.w;
    view.y -= ((cur.y - prev.y) / r.height) * view.h;
    apply();
  } else if (pointers.size === 2) {
    const [a, b] = [...pointers.values()];
    const d = Math.hypot(a.x - b.x, a.y - b.y);
    const c = toSvg((a.x + b.x) / 2, (a.y + b.y) / 2);
    if (pinchDist) zoomAt(pinchDist / d, c.x, c.y);
    pinchDist = d;
  }
});
const endPointer = (e: PointerEvent) => { pointers.delete(e.pointerId); pinchDist = 0; };
svg.addEventListener('pointerup', endPointer);
svg.addEventListener('pointercancel', endPointer);
svg.addEventListener('wheel', (e) => {
  e.preventDefault();
  const c = toSvg(e.clientX, e.clientY);
  zoomAt(e.deltaY > 0 ? 1.15 : 1 / 1.15, c.x, c.y);
}, { passive: false });
document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
  b.addEventListener('click', () => {
    const mode = b.dataset.zoom;
    if (mode === 'fit') return fit();
    zoomAt(mode === 'in' ? 0.8 : 1.25, view.x + view.w / 2, view.y + view.h / 2);
  })
);

// --- selection ---
const nodeEl = (id: string) => svg.querySelector<SVGGElement>(`.node[data-id="${id}"]`);
const dates = (p: any) => (p.living ? '' : [p.born, p.died].filter(Boolean).join(' – '));
function relatedButtons(label: string, ids: string[]) {
  if (!ids.length) return '';
  const items = ids.map((id) => `<button type="button" data-goto="${id}">${byId.get(id).name}</button>`).join('');
  return `<div class="rel"><h3>${label}</h3>${items}</div>`;
}
function select(id: string, recentre = true) {
  const p = byId.get(id);
  if (!p) return;
  svg.querySelectorAll('.node.selected').forEach((n) => n.classList.remove('selected'));
  const el = nodeEl(id);
  el?.classList.add('selected');
  if (recentre && el) {
    const m = /translate\(([\d.]+) ([\d.]+)\)/.exec(el.getAttribute('transform')!)!;
    const w = Math.min(fullW, 900);
    const r = svg.getBoundingClientRect();
    view = { x: Number(m[1]) + Number(el.querySelector('rect')!.getAttribute('width')) / 2 - w / 2, y: Number(m[2]) + 27 - (w * r.height / r.width) / 2, w, h: w * r.height / r.width };
    apply();
  }
  const parents = (p.parents ?? []) as string[];
  const partners = (p.partners ?? []) as string[];
  const children = people.filter((c: any) => c.parents?.includes(id)).map((c: any) => c.id);
  details.innerHTML =
    (p.photo ? `<img class="portrait" src="/family/${p.id}.jpg" alt="${p.name}" />` : '') +
    `<h2>${p.name}</h2>` +
    (dates(p) ? `<p class="dates">${dates(p)}</p>` : '') +
    (p.notes ? `<p>${p.notes}</p>` : '') +
    (p.check ? '<p class="check">Read from a hard-to-read photo, so this may be wrong.</p>' : '') +
    relatedButtons('Parents', parents) +
    relatedButtons('Partners', partners) +
    relatedButtons('Children', children);
}
svg.addEventListener('click', (e) => {
  if (moved > 6) return;
  const node = (e.target as Element).closest<SVGGElement>('.node');
  if (node) select(node.dataset.id!, false);
});
svg.addEventListener('keydown', (e) => {
  const node = (e.target as Element).closest<SVGGElement>('.node');
  if (node && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); select(node.dataset.id!, false); }
});
details.addEventListener('click', (e) => {
  const b = (e.target as Element).closest<HTMLElement>('[data-goto]');
  if (b) select(b.dataset.goto!);
});

// --- search ---
function search() {
  const q = input.value.trim().toLowerCase();
  results.innerHTML = '';
  if (!q) { results.hidden = true; return; }
  const hits = people.filter((p: any) => p.name.toLowerCase().includes(q)).slice(0, 8);
  results.hidden = false;
  results.innerHTML = hits.length
    ? hits.map((p: any) => `<li><button type="button" data-goto="${p.id}">${p.name}<span>${dates(p)}</span></button></li>`).join('')
    : '<li class="none">No one found</li>';
}
input.addEventListener('input', search);
input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') results.querySelector<HTMLElement>('[data-goto]')?.click();
});
results.addEventListener('click', (e) => {
  const b = (e.target as Element).closest<HTMLElement>('[data-goto]');
  if (!b) return;
  select(b.dataset.goto!);
  results.hidden = true;
});

start();
window.addEventListener('resize', start);
</script>

<style is:global>
.tree-page { max-width: 1000px; margin: 0 auto; padding: 4rem 1.5rem 6rem; color: var(--ink); }
.tree-page h1 { margin: 0 0 1rem; }
.placeholder-note { margin: 0 0 1.5rem; padding: 0.5rem 0.9rem; background: var(--illus-b); border-radius: 6px; color: var(--ink-soft); font-size: 0.9rem; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.tree-tools { position: relative; margin-bottom: 1rem; max-width: 420px; }
.tree-tools input { width: 100%; padding: 0.65rem 0.9rem; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-raised); color: var(--ink); }
.results { position: absolute; z-index: 5; left: 0; right: 0; margin: 4px 0 0; padding: 0; list-style: none; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 6px 20px rgb(var(--shadow) / 0.12); overflow: hidden; }
.results button { display: flex; justify-content: space-between; width: 100%; padding: 0.55rem 0.9rem; font: inherit; text-align: left; background: none; border: 0; cursor: pointer; color: var(--ink); }
.results button:hover { background: var(--illus-b); }
.results span, .results .none { color: var(--ink-faint); font-size: 0.85rem; }
.results .none { padding: 0.55rem 0.9rem; }
.tree-wrap { position: relative; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-raised); overflow: hidden; }
#tree { width: 100%; height: 60vh; min-height: 340px; touch-action: none; cursor: grab; user-select: none; }
#tree .links path { fill: none; stroke: var(--ink-faint); stroke-width: 1.5; }
#tree .node { cursor: pointer; }
#tree .node rect { fill: var(--bg); stroke: var(--line); stroke-width: 1.5; }
#tree .node:hover rect { stroke: var(--illus-a); }
#tree .node.selected rect { fill: var(--illus-b); stroke: var(--green); stroke-width: 2.5; }
#tree .node:focus-visible { outline: none; }
#tree .node:focus-visible rect { stroke: var(--accent); stroke-width: 3; }
#tree .name { font-size: 14px; font-weight: 600; fill: var(--ink); }
#tree .avatar { fill: var(--illus-b); stroke: var(--line); stroke-width: 1; }
#tree .initials { font-size: 13px; font-weight: 600; fill: var(--ink-soft); }
#tree .dates { font-size: 12px; fill: var(--ink-soft); }
.zoom-controls { position: absolute; right: 10px; bottom: 10px; display: flex; gap: 6px; }
.zoom-controls button { min-width: 38px; height: 38px; font: inherit; font-weight: 600; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; color: var(--ink); }
.zoom-controls button:hover { border-color: var(--illus-a); }
.details { margin-top: 1.25rem; padding: 1.25rem 1.5rem; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-raised); }
.details .portrait { width: 96px; height: 96px; margin-bottom: 0.6rem; border-radius: 50%; object-fit: cover; }
.details h2 { margin: 0; font-size: 1.3rem; }
.details p { margin: 0.4rem 0 0; color: var(--ink-soft); }
.details .check { font-size: 0.88rem; color: var(--illus-c); }
.details .hint { margin: 0; color: var(--ink-faint); font-size: 0.95rem; }
.details .rel { margin-top: 1rem; }
.details h3 { margin: 0 0 0.4rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); }
.details .rel button { margin: 0 0.4rem 0.4rem 0; padding: 0.3rem 0.75rem; font: inherit; font-size: 0.92rem; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; cursor: pointer; color: var(--ink); }
.details .rel button:hover { border-color: var(--illus-a); background: var(--illus-b); }
@media (max-height: 520px) and (orientation: landscape) {
  .tree-page { padding: 0.5rem 1rem 0.75rem; max-width: none; }
  .tree-page .back-link { margin-bottom: 0.25rem; }
  .tree-page h1 { display: inline-block; margin: 0 0 0.5rem 1rem; font-size: 1.1rem; }
  .placeholder-note { display: none; }
  .tree-tools { margin-bottom: 0.5rem; }
  .tree-tools input { padding: 0.3rem 0.75rem; }
  .tree-body { display: grid; grid-template-columns: 1fr 250px; gap: 0.75rem; }
  #tree { height: calc(100dvh - 6.25rem); min-height: 0; }
  .details { margin-top: 0; max-height: calc(100dvh - 6.25rem); overflow-y: auto; padding: 0.9rem 1rem; }
}
</style>
