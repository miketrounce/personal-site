---
import Layout from '../layouts/Layout.astro';
import LabeledList from '../components/LabeledList.astro';
import { process } from '../data/modus-operandi';
---
<Layout title="Modus Operandi — Mike Trounce">
  <h1 class="page-title">Modus Operandi</h1>

  <div class="flow-diagram">
    <svg viewBox="0 0 480 300" role="img" aria-label="A left-to-right workflow. On the left, three kinds of input: a soundwave for recorded conversations, a pair of slides for decks, and a pair of pages for your own documents. They converge into an Obsidian vault holding three folders — raw, holding your sources unedited; wiki, holding compiled cross-referenced knowledge, marked where two of your own figures disagree; and published, holding one document. A dashed boundary sealed with a padlock encloses the inputs and the whole vault. A single arrow leaves through a gate to a private GitHub repository on the right.">
      <defs>
        <marker id="tip" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
        </marker>
        <marker id="tipdn" viewBox="0 0 10 10" refX="5" refY="9" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 0 L5 10 L10 0 z" class="arrow-head" />
        </marker>
      </defs>

      <!-- private boundary -->
      <rect x="4" y="26" width="336" height="250" rx="8" class="boundary" />
      <g class="lock">
        <rect x="10" y="12" width="13" height="10" rx="2" />
        <path d="M13 12 V9.6 a3.6 3.6 0 0 1 7.2 0 V12" class="lock-shackle" />
      </g>
      <text x="30" y="21" class="tiny">private — my machine, encrypted</text>

      <!-- inputs: conversations -->
      <g class="wave">
        <rect x="14" y="69" width="5" height="14" rx="2.5" opacity=".55" />
        <rect x="22" y="65" width="5" height="22" rx="2.5" opacity=".75" />
        <rect x="30" y="67" width="5" height="18" rx="2.5" opacity=".65" />
        <rect x="38" y="63" width="5" height="26" rx="2.5" />
        <rect x="46" y="68" width="5" height="16" rx="2.5" opacity=".6" />
      </g>

      <!-- inputs: decks -->
      <rect x="22" y="110" width="34" height="20" rx="1.5" class="src-back" />
      <rect x="16" y="115" width="34" height="20" rx="1.5" class="src-front" />
      <rect x="19" y="118" width="15" height="2.5" rx="1" class="src-bar" />
      <line x1="19" y1="126" x2="44" y2="126" class="src-line" />
      <line x1="19" y1="131" x2="36" y2="131" class="src-line" />

      <!-- inputs: documents -->
      <rect x="24" y="158" width="24" height="30" rx="1.5" class="src-back" />
      <rect x="16" y="164" width="24" height="30" rx="1.5" class="src-front" />
      <line x1="20" y1="171" x2="36" y2="171" class="src-line" />
      <line x1="20" y1="177" x2="34" y2="177" class="src-line" />
      <line x1="20" y1="183" x2="36" y2="183" class="src-line" />
      <line x1="20" y1="189" x2="30" y2="189" class="src-line" />

      <text x="34" y="214" text-anchor="middle" class="tiny">conversations, decks,</text>
      <text x="34" y="226" text-anchor="middle" class="tiny">documents — as they are</text>

      <!-- converge -->
      <g class="converge">
        <path d="M56 76 C 66 76, 68 142, 72 148" />
        <path d="M52 125 C 64 125, 68 146, 72 150" />
        <path d="M42 200 C 60 208, 68 162, 72 154" />
      </g>
      <line x1="74" y1="151" x2="90" y2="151" class="flow" marker-end="url(#tip)" />

      <!-- the vault -->
      <rect x="96" y="40" width="224" height="224" rx="6" class="vault" />
      <g transform="translate(104,46) scale(0.8)" class="obsidian">
        <path d="M8.6 .6 L15.4 6.4 L10.8 18.4 L4.2 18.4 L.8 8.2 Z" class="obs-body" />
        <path d="M8.6 .6 L5.9 7.6 L10.8 18.4" class="obs-facet" />
        <path d="M5.9 7.6 L.8 8.2" class="obs-facet" />
        <path d="M5.9 7.6 L15.4 6.4" class="obs-facet" />
      </g>
      <text x="122" y="59" class="vault-title">Obsidian vault</text>

      <!-- raw/ -->
      <rect x="104" y="72" width="208" height="46" rx="3" class="row" />
      <rect x="113" y="83" width="11" height="15" rx="1" class="row-icon" />
      <rect x="117" y="87" width="11" height="15" rx="1" class="row-icon solid" />
      <text x="138" y="92" class="folder">raw/</text>
      <text x="138" y="107" class="tiny">your sources, unedited</text>

      <line x1="120" y1="118" x2="120" y2="130" class="flow" marker-end="url(#tipdn)" />

      <!-- wiki/ -->
      <rect x="104" y="130" width="208" height="56" rx="3" class="row lit" />
      <g class="row-icon">
        <rect x="113" y="141" width="9" height="12" rx="1" />
        <rect x="124" y="148" width="9" height="12" rx="1" />
        <line x1="122" y1="147" x2="124" y2="150" />
      </g>
      <text x="138" y="150" class="folder">wiki/</text>
      <text x="138" y="164" class="tiny">linked · every claim sourced</text>
      <text x="138" y="177" class="tiny flag-text">two of your figures disagree</text>
      <circle cx="294" cy="152" r="11" class="flag-badge" />
      <text x="294" y="157" text-anchor="middle" class="flag-glyph">&#8800;</text>

      <line x1="120" y1="186" x2="120" y2="198" class="flow" marker-end="url(#tipdn)" />

      <!-- published/ -->
      <rect x="104" y="198" width="208" height="46" rx="3" class="row" />
      <path d="M113 209 h10 l4 4 v14 a1.5 1.5 0 0 1 -1.5 1.5 h-12.5 a1.5 1.5 0 0 1 -1.5 -1.5 v-16.5 a1.5 1.5 0 0 1 1.5 -1.5 z" class="row-icon" />
      <text x="138" y="218" class="folder">published/</text>
      <text x="138" y="233" class="tiny">one document — all that ever leaves</text>

      <!-- out through the gate -->
      <line x1="320" y1="221" x2="332" y2="221" class="flow" />
      <rect x="334" y="209" width="9" height="24" rx="2" class="gate" />
      <line x1="347" y1="221" x2="384" y2="221" class="flow" marker-end="url(#tip)" />
      <text x="366" y="205" text-anchor="middle" class="tiny">on your word</text>

      <!-- github -->
      <circle cx="422" cy="221" r="26" class="gh-disc" />
      <g class="gh-mark">
        <path d="M414 208 q-1.4 -4.6 0 -7 q3.4 0 5.6 2.4 q2.6 -.7 5 0 q2.2 -2.4 5.6 -2.4 q1.4 2.4 0 7 q3.2 3.2 3.2 7.6 q0 8.2 -7 10 q1.9 1.9 1.9 5 v7.4 q-5 1.3 -9.4 0 v-7.4 q0 -3.1 1.9 -5 q-7 -1.8 -7 -10 q0 -4.4 3.2 -7.6 z" />
        <path d="M411.6 228 q-4.4 1.2 -5.6 -3.1 q-.6 -2.5 -3.1 -3.1 q3.1 -.6 5 1.9 q1.9 3.1 4.4 1.9 z" />
      </g>
      <text x="422" y="264" text-anchor="middle" class="gh-label">GitHub</text>
      <text x="422" y="277" text-anchor="middle" class="tiny">private repo — yours to read</text>
    </svg>
  </div>

  <LabeledList items={process} />
</Layout>

<style>
  .flow-diagram {
    margin: 0 0 40px;
  }

  .flow-diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --- structure --- */
  .boundary {
    fill: none;
    stroke: var(--accent-dark);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }

  .lock rect {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .lock-shackle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .vault {
    fill: var(--panel);
    stroke: var(--border);
    stroke-width: 1;
  }

  .row {
    fill: var(--panel-strong);
    stroke: var(--border);
    stroke-width: 1;
  }

  .row.lit {
    stroke: var(--accent);
  }

  .gate {
    fill: var(--panel);
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  /* --- inputs --- */
  .wave rect {
    fill: var(--accent);
  }

  .src-back {
    fill: var(--panel);
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.5;
  }

  .src-front {
    fill: var(--panel-strong);
    stroke: var(--accent);
    stroke-width: 1.2;
  }

  .src-bar {
    fill: var(--accent);
  }

  .src-line {
    stroke: var(--muted);
    stroke-width: 1;
    opacity: 0.5;
  }

  /* --- flow --- */
  .flow {
    stroke: var(--accent);
    stroke-width: 1.3;
    fill: none;
  }

  .arrow-head {
    fill: var(--accent);
  }

  .converge path {
    stroke: var(--accent);
    stroke-width: 1;
    fill: none;
    opacity: 0.5;
  }

  /* --- vault contents --- */
  .obs-body {
    fill: #a48af0;
  }

  .obs-facet {
    fill: none;
    stroke: #6e5bb8;
    stroke-width: 1;
  }

  .row-icon {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }

  .row-icon.solid {
    fill: var(--panel-strong);
  }

  .vault-title {
    font-size: 11px;
    font-weight: 700;
    fill: var(--text);
  }

  .folder {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--accent);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }

  .tiny {
    font-size: 9.5px;
    fill: var(--muted);
  }

  /* --- the finding --- */
  .flag-badge {
    fill: var(--panel);
    stroke: #e0a63a;
    stroke-width: 1.3;
  }

  .flag-glyph {
    font-size: 12px;
    font-weight: 700;
    fill: #e0a63a;
  }

  .flag-text {
    fill: #e0a63a;
  }

  /* --- github --- */
  .gh-disc {
    fill: var(--muted);
  }

  .gh-mark path {
    fill: var(--panel);
  }

  .gh-label {
    font-size: 11px;
    font-weight: 700;
    fill: var(--text);
  }
</style>
