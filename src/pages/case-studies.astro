---
  import Layout from '../layouts/Layout.astro';
const studies = [
{ title: 'The Greensman', desc: 'A garden business paying £125 a year for a website with the wrong address on its own flyer.', href: '/case-study-1' },
{ title: 'This website', desc: 'The general approach behind miketrounce.com itself — one clear job, built plainly.', href: '/case-study-2' },
];
---

<Layout
title="Case studies — Mike Trounce"
description="Real examples of the work — what was wrong, what changed, and why."
>
<div class="options-page">
<a href="/" class="back-link">&larr; Mike Trounce</a>

<h1>Case studies</h1>

<ul class="cs-list">
{studies.map((s) => (
<li class="cs-item">
<a href={s.href}>{s.title}</a>
<p>{s.desc}</p>
</li>
))}
</ul>
</div>
</Layout>

<style>
.options-page {
max-width: 640px;
margin: 0 auto;
padding: 4rem 1.5rem 6rem;
color: var(--ink);
}

.back-link {
display: inline-block;
margin-bottom: 3rem;
color: var(--ink-soft);
text-decoration: none;
font-size: 0.9rem;
}

.back-link:hover {
color: var(--accent);
}

h1 {
margin: 0 0 2.5rem;
}

.cs-list {
list-style: none;
margin: 0;
padding: 0;
border-top: 1px solid var(--line);
}

.cs-item {
padding: 1.5rem 0;
border-bottom: 1px solid var(--line);
}

.cs-item a {
font-family: 'Fraunces', Georgia, serif;
font-size: 1.4rem;
color: var(--ink);
text-decoration: none;
border-bottom: 1px solid var(--illus-a);
}

.cs-item a:hover {
color: var(--green);
}

.cs-item p {
margin: 0.5rem 0 0;
color: var(--ink-soft);
font-size: 0.98rem;
}
</style>
