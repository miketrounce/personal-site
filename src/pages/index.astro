              </a>
            </div>
            <span class="video-progress" aria-hidden="true"><span></span></span>
            <button type="button" class="video-play-btn" aria-label="Play The Greensman video">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="var(--ink)"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  * {
    box-sizing: border-box;
  }
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    min-height: auto;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Figtree', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .col-heading {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  /* ---------- two-column layout: video left, credentials right ---------- */
  .layout-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1rem, 4vh, 2rem) clamp(1.5rem, 5vw, 3rem);
  }
  @media (min-width: 900px) {
    .layout-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      align-items: stretch;
      gap: 0;
    }
  }

  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    width: 100%;
  }
  @media (min-width: 900px) {
    .content-col {
      padding-left: 2.5rem;
    }
  }

  /* ---------- intro video (left bar) ---------- */
  .video-col {
    width: 100%;
  }
  @media (min-width: 900px) {
    .video-col {
      padding-right: 2.5rem;
      border-right: 1px solid var(--ink);
    }
  }
  .intro-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--ink);
    border-radius: 20px;
    overflow: hidden;
    background: var(--illus-b);
  }
  .intro-video video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    cursor: pointer;
  }
  .video-play-btn {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: none;
    border-radius: 999px;
    background: #fff;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .video-play-btn svg {
    width: 14px;
    height: 14px;
    margin-left: 2px;
  }
  .video-play-btn:hover {
    transform: scale(1.08);
  }
  .video-duration {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: rgba(32, 35, 34, 0.7);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
    color: #fff;
    pointer-events: none;
  }
  .video-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    display: none;
    background: rgba(255, 255, 255, 0.25);
    pointer-events: none;
  }
  .video-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: #fff;
  }
  .intro-video.is-playing:not(.has-controls) .video-progress {
    display: block;
  }
  .video-corner {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .video-corner .video-duration {
    position: static;
  }
  .video-site-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    background: #fff;
    transition: transform 0.15s ease;
  }
  /* invisible padding so the tap target is ~44px on touch screens */
  .video-site-link::after {
    content: '';
    position: absolute;
    inset: -0.55rem;
  }
  .video-site-link:hover {
    transform: scale(1.08);
  }
  .video-duration:empty,
  .intro-video.is-playing .video-corner,
  .intro-video.is-playing .video-duration,
  .intro-video.is-playing .video-play-btn {
    display: none;
  }

  @media (max-width: 560px) {
    .site-header {
      justify-content: flex-start;
    }
  }
</style>
