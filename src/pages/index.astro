---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mike Trounce — Growth Engineer"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce</span>
        <span class="logotype-tag">Growth Engineer</span>
      </a>
    </header>
  </div>

  <main id="main-content">

    <div class="content-col">
      <a class="greensman-link" href="/the-greensman">The Greensman</a>
    </div>
  </main>
</Layout>

<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    min-height: auto;
  }

  /* ---------- hero zone: header gets a subtle dot-grid backdrop ---------- */
  .hero-zone {
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2rem) 1.5rem;
  }

  /* ---------- the one link ---------- */
  .greensman-link {
    display: inline-block;
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 4px solid var(--illus-a);
  }
  .greensman-link:hover {
    color: var(--green);
  }

  @media (max-width: 560px) {
    .site-header {
      justify-content: flex-start;
    }
  }
</style>
