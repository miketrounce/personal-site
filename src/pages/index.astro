---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mike Trounce — Growth Engineer"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce &amp; Co.</span>
        <span class="logotype-tag">Growth Engineers</span>
      </a>
    </header>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.intro-video').forEach(function (wrap) {
        var video = wrap.querySelector('video');
        var btn = wrap.querySelector('.video-play-btn');
        var runtime = wrap.querySelector('.video-duration');
        var progress = wrap.querySelector('.video-progress span');
        if (!video || !btn) return;
        function showRuntime() {
          if (!runtime || !isFinite(video.duration)) return;
          var secs = Math.round(video.duration);
          runtime.textContent = Math.floor(secs / 60) + ':' + ('0' + (secs % 60)).slice(-2);
        }
        if (video.readyState >= 1) showRuntime();
        video.addEventListener('loadedmetadata', showRuntime);
        btn.addEventListener('click', function () { video.play(); });
        // Playback starts clean: the browser's own controls (scrubber, time, volume,
        // fullscreen) only come in when asked for — a tap on a phone, the mouse on a
        // desktop — so nothing covers the opening seconds.
        function showControls() {
          video.controls = true;
          wrap.classList.add('has-controls');
        }
        function reset() {
          video.controls = false;
          wrap.classList.remove('is-playing', 'has-controls');
        }
        video.addEventListener('click', function () {
          if (video.controls) return;
          if (video.paused) video.play(); else showControls();
        });
        video.addEventListener('pointermove', function (e) {
          if (e.pointerType === 'mouse' && !video.paused && !video.controls) showControls();
        });
        video.addEventListener('play', function () {
          wrap.classList.add('is-playing');
          document.querySelectorAll('.intro-video video').forEach(function (v) {
            if (v !== video) v.pause();
          });
        });
        video.addEventListener('pause', function () {
          if (!video.controls && !video.ended) reset();
        });
        video.addEventListener('timeupdate', function () {
          if (progress && video.duration) progress.style.width = (video.currentTime / video.duration * 100) + '%';
        });
        // back to the clean still once it finishes
        video.addEventListener('ended', function () {
          reset();
          video.load();
        });
      });
    });
  </script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var videoBox = document.getElementById('video-panels');
      var greensmanBox = document.getElementById('portfolio-panels');
      if (!videoBox || !greensmanBox) return;
      var mq = window.matchMedia('(min-width: 900px)');
      function syncWidth() {
        if (mq.matches) {
          greensmanBox.style.width = videoBox.getBoundingClientRect().width + 'px';
        } else {
          greensmanBox.style.width = '';
        }
      }
      syncWidth();
      window.addEventListener('resize', syncWidth);
    });
  </script>

  <main id="main-content">

    <div class="layout-grid">
      <div class="video-col">
        <h2 class="col-heading">Why</h2>

        <div id="video-panels">
          <div class="intro-video" id="intro-video">
            <video id="intro-video-el" preload="metadata" poster="/media/why-poster.jpg" playsinline>
              <source src="/media/why.mp4" type="video/mp4" />
            </video>
            <span class="video-duration" aria-hidden="true"></span>
            <span class="video-progress" aria-hidden="true"><span></span></span>
            <button type="button" class="video-play-btn" aria-label="Play video">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="var(--ink)"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="content-col">
        <h2 class="col-heading">Growth Stories</h2>

        <div id="portfolio-panels">
          <div class="intro-video" id="greensman-video">
            <video preload="metadata" poster="/freddy-greensman.jpg" playsinline>
              <source src="/media/greensman.mp4" type="video/mp4" />
            </video>
            <div class="video-corner">
              <span class="video-duration" aria-hidden="true"></span>
              <a class="video-site-link" href="https://www.thegreensmanelstead.com/" target="_blank" rel="noopener" aria-label="The Greensman Elstead website">
                <img src="/greensman-icon.png" alt="" width="16" height="16" />
              </a>
              <a class="video-site-link" href="https://www.instagram.com/trouncetalks/" target="_blank" rel="noopener" aria-label="Freddy on Instagram">
                <svg viewBox="0 0 24 24" width="15" height="15"><defs><linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#FEDA75"/><stop offset="35%" stop-color="#D62976"/><stop offset="70%" stop-color="#962FBF"/><stop offset="100%" stop-color="#4F5BD5"/></linearGradient></defs><path fill="url(#ig-grad)" d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.0