<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    min-height: auto;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .video-contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .social-nav,
  .contact-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .icon-link:hover {
    border-color: var(--ink);
    transform: scale(1.06);
  }
  /* ---------- two-column layout: video left, credentials right ---------- */
  .layout-grid {
    display: flex;
    flex-direction: column;
