---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mike Trounce — Startup Consultant for Early-Stage Founders"
  description="I work with early-stage founders on fundraising and on making the story of your company something you can hand to anyone and trust it's current."
>
  <main class="wrap one-view">
    <div class="header-row">
      <img class="hero-photo" src="/mike.jpg" alt="Mike Trounce" loading="eager" width="184" height="282" />
      <div class="header-text">
        <h1 class="name">Mike Trounce</h1>
        <p class="tagline">Startup consultant for early-stage founders</p>
      </div>
    </div>

    <p class="pitch">
      I work with early-stage founders on fundraising and on making your company&rsquo;s story
      something you can hand to anyone and trust it&rsquo;s current. Recently: a living document
      I call the <strong>Company Memo</strong>, built with a founder currently raising money, so
      the story never goes stale.
    </p>

    <p class="contact-line">
      Got something worth building? <a class="contact-email" href="mailto:trounceflow@gmail.com">trounceflow@gmail.com</a>
    </p>
  </main>
</Layout>
