---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import freddyPhoto from '../assets/freddy-greensman.jpg';
---

<Layout
  title="Mike Trounce — Growth Engineer"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce</span>
        <span class="logotype-tag">Growth Engineer</span>
      </a>
    </header>
  </div>

  <main id="main-content">

    <div class="content-col">
      <section class="example">
        <a class="example-thumb" href="/the-greensman" aria-label="The Greensman, in full">
          <Image class="example-photo" src={freddyPhoto} alt="Freddy Trounce, The Greensman, working in a client's garden" width={640} height={360} />
          <span class="play-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          </span>
        </a>
        <div>
          <h2>Stories</h2>
          <p>Freddy's garden and grounds business didn't need one big project. It needed someone who kept noticing what was next — cheaper hosting, a corrected flyer, a rebuilt brand, a quote video that tripled a job, a WhatsApp system so leads stopped slipping through, his own following built up. Eight fixes and counting, each one making the next one obvious — with a contractor brokerage already taking shape.</p>
          <p class="example-link"><a href="/the-greensman">The Greensman, in full</a> &middot; <a href="/stories">All stories</a></p>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    min-height: auto;
  }

  /* ---------- hero zone: header gets a subtle dot-grid backdrop ---------- */
  .hero-zone {
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2rem) 1.5rem;
  }

  /* ---------- worked example: styled like a video thumbnail ---------- */
  .example {
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
  }
  .example-thumb {
    position: relative;
    display: block;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 16 / 9;
    margin: 0 0 1.1rem;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(var(--shadow) / 0.05), 0 18px 34px -18px rgba(var(--shadow) / 0.4);
  }
  .example-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 25%;
    transition: transform 0.2s ease;
  }
  .example-thumb:hover .example-photo {
    transform: scale(1.03);
  }
  .play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3.2rem;
    height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 0.15rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease;
  }
  .example-thumb:hover .play-badge {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .example h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .example p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .example-link {
    margin-top: 0.6rem;
  }
  .example-link a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .example-link a:hover {
    color: var(--green);
  }

  @media (max-width: 560px) {
    .site-header {
      justify-content: flex-start;
    }
  }
</style>
