---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import mikePhoto from '../assets/mike.jpg';
import freddyPhoto from '../assets/freddy-greensman.jpg';

const jobs = [
  { job: "Your website", line: "Build one, or find out why the one you've got costs what it does.", href: "/website-options" },
  { job: "Your clients", line: "Set up a CRM, fix the one you've got, or cut what it costs you.", href: null },
  { job: "Your accounts", line: "Get them set up, or get what you've set up to cost less.", href: null },
  { job: "Your adverts", line: "Get them running, or stop them costing more than they bring in.", href: "/promoting-your-business" },
];

const employers = [
  "Exante Data", "Trounceflow", "Standard Chartered", "JPMorgan",
  "Nomura", "Markit", "Societe Generale", "BNP Paribas",
];
---

<Layout
  title="Mike Trounce — Get Things Done!"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce</span>
        <span class="logotype-tag">Get Things Done</span>
      </a>
      <nav class="top-nav gated">
        <a class="quiet" href="/about">About</a>
        <a class="quiet" href="/how-i-work">How I work</a>
        <a class="quiet" href="/stories">Stories</a>
        <a class="quiet" href="/hire-me">Hire me</a>
        <a class="quiet" href="mailto:trounceflow@gmail.com">Contact</a>
        <a class="icon-link" href="https://www.linkedin.com/in/michael-trounce/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        <a class="icon-link" href="https://www.youtube.com/@michaeltrounce3746" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
      </nav>
    </header>

    <section class="intro" id="intro-gate">
      <h1 class="lede">Are you an entrepreneur?</h1>
      <div class="gate">
        <button type="button" class="gate-btn gate-yes" id="gate-yes">Yes</button>
        <button type="button" class="gate-btn gate-no" id="gate-no">No</button>
      </div>
    </section>
  </div>

  <noscript>
    <style>.gated { display: block !important; } nav.gated { display: flex !important; }</style>
  </noscript>

  <main id="main-content" class="gated">

    <div class="content-col">
      <section class="proof">
        <Image class="proof-photo" src={freddyPhoto} alt="Freddy Trounce, The Greensman" width={72} height={72} />
        <div>
          <p class="proof-lede">So is Freddy. I work with him — here's what he said:</p>
          <blockquote class="proof-quote">
            <p>&ldquo;This is great.&rdquo;</p>
            <cite>Freddy Trounce, The Greensman</cite>
          </blockquote>
        </div>
      </section>

      <ul class="jobs">
        {jobs.map((j) => (
          <li class="job">
            {j.href ? <a href={j.href}>{j.job}</a> : <span>{j.job}</span>}
              <span class="job-line">{j.line}</span>
          </li>
        ))}
      </ul>

      <section class="example">
        <Image class="example-photo" src={freddyPhoto} alt="Freddy Trounce, The Greensman, working in a client's garden" width={96} height={96} />
        <div>
          <h2>Stories</h2>
          <p>Freddy's garden and grounds business in Elstead was paying £125 a year to keep a website online, and handing out a flyer with the wrong web address on it. Neither needed a big project. They needed someone to notice.</p>
          <p class="example-link"><a href="/the-greensman">The Greensman, in full</a> &middot; <a href="/stories">All stories</a></p>
        </div>
      </section>

      <!-- Placeholder testimonials — fake names, fake quotes. Swap for real ones before this is taken seriously as a commercial page. -->
      <section class="testimonials">
        <h2>What people say</h2>
        <div class="testimonial-list">
          <blockquote class="testimonial">
            <p>&ldquo;Placeholder testimonial — swap in a real quote here.&rdquo;</p>
            <cite>Joe Blogs, Placeholder role</cite>
          </blockquote>
          <blockquote class="testimonial">
            <p>&ldquo;Placeholder testimonial — swap in a real quote here.&rdquo;</p>
            <cite>Billy X, Placeholder role</cite>
          </blockquote>
          <blockquote class="testimonial">
            <p>&ldquo;Placeholder testimonial — swap in a real quote here.&rdquo;</p>
            <cite>Jane Doe, Placeholder role</cite>
          </blockquote>
        </div>
      </section>
    </div>

    <section class="employers-band">
      <div class="employers-inner">
        <h2>Where I've worked</h2>
        <ul class="employers-list">
          {employers.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </section>

    <div class="content-col">
      <section class="engage">
        <h2>Work with me</h2>
        <div class="engage-cards">
          <a class="engage-card" href="/consultant">
            <h3>Consultant</h3>
            <p>Talk it through — your dealflow, your leads, what's working.</p>
          </a>
          <a class="engage-card" href="/builder">
            <h3>Builder</h3>
            <p>Have it done — a CRM, a website, the marketing.</p>
          </a>
        </div>
        <p class="engage-more"><a href="/hire-me">More on how both work &rarr;</a></p>
      </section>

      <div class="sign-off">
        <Image class="face" src={mikePhoto} alt="Mike Trounce" width={184} height={282} loading="eager" />
        <p>
          Got something worth building? <a class="contact-email" href="mailto:trounceflow@gmail.com">trounceflow@gmail.com</a>
        </p>
      </div>
    </div>
  </main>

  <footer class="site-footer gated">
    <p>Mike Trounce &middot; <a href="mailto:trounceflow@gmail.com">trounceflow@gmail.com</a></p>
  </footer>
</Layout>

<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
  }

  /* ---------- hero zone: header + intro share a subtle dot-grid backdrop ---------- */
  .hero-zone {
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* ---------- gate: hidden until "Yes" is clicked; see <noscript> override and the
     page script for the no-JS / JS-enabled fallback behavior ---------- */
  .gated {
    display: none !important;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .top-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .icon-link:hover {
    color: var(--ink-soft);
    border-color: var(--illus-a);
  }

  /* ---------- intro: headline only, text-first like the reference's first screen ---------- */
  .intro {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(4rem, 14vh, 9rem) clamp(1.5rem, 5vw, 3rem) clamp(3rem, 10vh, 6rem);
  }
  .lede {
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    white-space: nowrap;
    margin: 0;
  }
  .gate {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  .gate-btn {
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.8rem 2.4rem;
    border-radius: 999px;
    cursor: pointer;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    transition: background 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }
  .gate-yes {
    background: var(--ink);
    color: var(--bg-raised);
  }
  .gate-yes:hover {
    opacity: 0.8;
  }
  .gate-no:hover {
    background: var(--ink);
    color: var(--bg-raised);
  }

  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2rem) 1.5rem;
  }

  /* ---------- proof: Freddy's answer to the gate question ---------- */
  .proof {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
    padding-bottom: clamp(2.2rem, 5vh, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .proof-photo {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    object-position: 45% 20%;
  }
  .proof-lede {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .proof-quote {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--illus-a);
  }
  .proof-quote p {
    margin: 0 0 0.3rem;
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .proof-quote cite {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* ---------- the list ---------- */
  .jobs {
    list-style: none;
    margin: 0 0 clamp(2.8rem, 6vh, 4rem);
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .job {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .job a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .job a:hover {
    color: var(--green);
  }
  .job-line { display: block; margin-top: 0.3rem; font-family: 'Figtree', system-ui, sans-serif; font-size: 1rem; line-height: 1.5; color: var(--ink-soft); }

  /* ---------- worked example ---------- */
  .example {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
  }
  .example-photo {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    object-position: 45% 20%;
  }
  .example h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .example p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .example-link {
    margin-top: 0.6rem;
  }
  .example-link a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .example-link a:hover {
    color: var(--green);
  }

  /* ---------- testimonials ---------- */
  .testimonials {
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
  }
  .testimonials h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .testimonial-list {
    display: grid;
    gap: 1rem;
  }
  .testimonial {
    margin: 0;
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--illus-a);
  }
  .testimonial p {
    margin: 0 0 0.4rem;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .testimonial cite {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* ---------- where I've worked ---------- */
  .employers-band {
    background: var(--illus-b);
    padding: clamp(3rem, 7vh, 4.5rem) clamp(1.5rem, 5vw, 3rem);
    margin: 0 0 clamp(1rem, 4vh, 2rem);
  }
  .employers-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .employers-band h2 {
    margin: 0 0 1.5rem;
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--ink);
  }
  .employers-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2.5rem;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }
  .employers-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* ---------- work with me ---------- */
  .engage {
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
  }
  .engage h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .engage-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .engage-card {
    display: block;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
  }
  .engage-card:hover {
    border-color: var(--illus-a);
  }
  .engage-card h3 {
    margin: 0 0 0.35rem;
    font-family: 'Outfit', 'Figtree', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .engage-card:hover h3 {
    color: var(--green);
  }
  .engage-card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .engage-more {
    margin: 0.9rem 0 0;
  }
  .engage-more a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .engage-more a:hover {
    color: var(--green);
  }

  /* ---------- sign-off ---------- */
  .sign-off {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(1.6rem, 4vh, 2.4rem);
    border-top: 1px solid var(--line);
  }
  .face {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 16%;
  }
  .sign-off p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .contact-email {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--illus-a);
  }
  .contact-email:hover {
    color: var(--green);
  }
  .quiet {
    font-size: 0.9rem;
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .quiet:hover {
    color: var(--ink-soft);
  }

  .site-footer {
    padding: clamp(1.6rem, 4vh, 2.2rem) 1.5rem 3rem;
    text-align: center;
  }
  .site-footer p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .site-footer a {
    color: var(--ink-faint);
  }

  @media (max-width: 650px) {
    .lede {
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .job {
      font-size: 1.35rem;
    }
    .engage-cards {
      grid-template-columns: 1fr;
    }
    .employers-list {
      grid-template-columns: 1fr;
    }
    .site-header {
      justify-content: flex-start;
    }
  }
</style>

<script>
  const exits = [
    'https://www.google.com',
    'https://www.amazon.com',
    'https://www.ebay.com',
    'https://www.instagram.com',
    'https://www.facebook.com',
  ];

  function revealSite() {
    document.querySelectorAll('.gated').forEach((el) => el.classList.remove('gated'));
    const introGate = document.getElementById('intro-gate');
    if (introGate) introGate.style.display = 'none';
    try {
      sessionStorage.setItem('entrepreneur', 'yes');
    } catch (e) {}
  }

  let alreadyPassed = false;
  try {
    alreadyPassed = sessionStorage.getItem('entrepreneur') === 'yes';
  } catch (e) {}
  if (alreadyPassed) revealSite();

  document.getElementById('gate-yes')?.addEventListener('click', () => {
    revealSite();
    document.getElementById('main-content')?.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('gate-no')?.addEventListener('click', () => {
    window.location.href = exits[Math.floor(Math.random() * exits.length)];
  });
</script>
