---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mike Trounce — Growth Engineer"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce</span>
        <span class="logotype-tag">Growth Engineer</span>
      </a>
      <nav class="social-nav">
        <a class="icon-link" href="https://www.linkedin.com/in/michael-trounce/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        <a class="icon-link" href="https://www.facebook.com/michael.trounce.5" target="_blank" rel="noopener" aria-label="Facebook">FB</a>
        <a class="icon-link" href="https://x.com/TrounceMichael" target="_blank" rel="noopener" aria-label="X">X</a>
        <a class="icon-link" href="https://www.instagram.com/michaeltrounce/" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
        <a class="icon-link" href="https://www.youtube.com/@michaeltrounce3746" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
        <a class="icon-link" href="https://wa.me/447887546080" target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>
      </nav>
    </header>
  </div>

  <main id="main-content">

    <div class="content-col">
      <div class="greensman-box">
        <div class="greensman-heading">
          <h2 class="greensman-title">The Greensman</h2>
          <a class="icon-link" href="https://www.youtube.com/@michaeltrounce3746" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
        </div>
        <div class="story-list">
          <details class="story-row">
            <summary class="story-summary">
              <span class="play-circle" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
              <span class="story-text">
                <span class="story-episode">Episode 1</span>
                <span class="story-title">Breaking Ground</span>
              </span>
            </summary>
            <div class="story-video">
              <video controls preload="metadata" poster="/media/kabir-poster.jpg" playsinline>
                <source src="/media/kabir-reel.mp4" type="video/mp4" />
              </video>
            </div>
          </details>

          <div class="story-row story-row--soon">
            <span class="play-circle play-circle--soon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </span>
            <span class="story-text">
              <span class="story-episode">Episode 2</span>
              <span class="story-title">Overload</span>
            </span>
          </div>

          <div class="story-row story-row--soon">
            <span class="play-circle play-circle--soon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </span>
            <span class="story-text">
              <span class="story-episode">Episode 3</span>
              <span class="story-title">The Prize</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    min-height: auto;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .social-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .icon-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2rem) 1.5rem;
  }

  /* ---------- the one story ---------- */
  .greensman-box {
    border: 1px solid var(--ink);
    border-radius: 20px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .greensman-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
  }
  .greensman-title {
    margin: 0;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .story-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 480px;
  }
  .story-row {
    border: none;
  }
  .story-summary {
    cursor: pointer;
    list-style: none;
  }
  .story-summary::-webkit-details-marker {
    display: none;
  }
  .story-summary,
  .story-row--soon {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0;
  }
  .play-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3.2rem;
    height: 3.2rem;
    padding-left: 0.15rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg-raised);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .story-summary:hover .play-circle {
    transform: scale(1.08);
    background: var(--green);
  }
  .play-circle--soon {
    background: var(--illus-b);
    color: var(--ink-faint);
    box-shadow: none;
  }
  .story-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .story-title {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .story-row--soon .story-title {
    color: var(--ink-faint);
  }
  .story-episode {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .story-video {
    max-width: 240px;
    margin: 0.75rem 0 0.5rem 4.2rem;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 18px 34px -18px rgba(0, 0, 0, 0.4);
  }
  .story-video video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: #000;
  }

  @media (max-width: 560px) {
    .site-header {
      justify-content: flex-start;
    }
  }
</style>
