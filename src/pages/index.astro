---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mike Trounce — Growth Engineer"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <div class="hero-zone">
    <header class="site-header">
      <a class="logotype" href="/">
        <span class="logotype-name">Mike Trounce</span>
        <span class="logotype-tag">Growth Engineer</span>
      </a>
    </header>
  </div>

  <main id="main-content">

    <div class="content-col">
      <h2 class="greensman-title">The Greensman</h2>
      <div class="story-grid">
        <div class="story-video">
          <video controls preload="metadata" poster="/media/kabir-poster.jpg" playsinline>
            <source src="/media/kabir-reel.mp4" type="video/mp4" />
          </video>
          <span class="story-part">Part 1</span>
        </div>
        <div class="story-video story-video--soon">
          <span class="story-soon">Coming soon</span>
          <span class="story-part">Part 2</span>
        </div>
        <div class="story-video story-video--soon">
          <span class="story-soon">Coming soon</span>
          <span class="story-part">Part 3</span>
        </div>
      </div>
      <p class="greensman-caption">Eight fixes and counting — cheaper hosting, a corrected flyer, a rebuilt brand, this reel that tripled a quote, a WhatsApp system so leads stopped slipping through, his own following built up — with a contractor brokerage and a second YouTube channel next.</p>
    </div>
  </main>
</Layout>

<style>
  /* ---------- monochrome palette override, this page only ---------- */
  /* Matches the near-black/off-white values pulled from javierbajer.com's own
     CSS — no green/sage accents on this page while we're matching his look. */
  :root {
    --ink: #202322;
    --ink-soft: #363938;
    --ink-faint: #5a5c5a;
    --line: #d8d8d6;
    --green: #202322;
    --illus-a: #202322;
    --illus-b: #e8e8e6;
    --bg-raised: #ffffff;
    --shadow: 0 0 0;
  }
  :global(body) {
    background: #f0f0f0;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 22px 22px;
    min-height: auto;
  }

  /* ---------- top nav ---------- */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.4rem clamp(1.5rem, 5vw, 3rem);
  }
  .logotype {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
  }
  .logotype-name {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .logotype-tag {
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  /* ---------- content column (narrow sections between full-bleed bands) ---------- */
  .content-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 2rem) 1.5rem;
  }

  /* ---------- the one story ---------- */
  .greensman-title {
    margin: 0 0 1.25rem;
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 760px;
  }
  .story-video {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 18px 34px -18px rgba(0, 0, 0, 0.4);
  }
  .story-video video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: #000;
  }
  .story-video--soon {
    aspect-ratio: 9 / 16;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--illus-b);
    box-shadow: none;
    border: 1px dashed var(--line);
  }
  .story-soon {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .story-part {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .story-video--soon .story-part {
    background: var(--bg-raised);
  }
  @media (max-width: 640px) {
    .story-grid {
      grid-template-columns: 1fr;
      max-width: 240px;
    }
  }

  .greensman-caption {
    max-width: 48ch;
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  @media (max-width: 560px) {
    .site-header {
      justify-content: flex-start;
    }
  }
</style>
