---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import mikePhoto from '../assets/mike.jpg';
import freddyPhoto from '../assets/freddy-greensman.jpg';

const jobs = [
  { job: "Your website", line: "Build one, or find out why the one you've got costs what it does.", href: "/website-options" },
  { job: "Your clients", line: "Set up a CRM, fix the one you've got, or cut what it costs you.", href: null },
  { job: "Your accounts", line: "Get them set up, or get what you've set up to cost less.", href: null },
  { job: "Your adverts", line: "Get them running, or stop them costing more than they bring in.", href: "/promoting-your-business" },
];
---

<Layout
  title="Mike Trounce — The jobs that never make it to the top of your list"
  description="Give me an hour. If I find nothing, you don't pay."
>
  <main class="home">
    <p class="eyebrow">Mike Trounce</p>

    <h1 class="lede">The jobs that never make it to the top of your list.</h1>

    <p class="standfirst">Give me an hour. If I find nothing, you don't pay.</p>

    <div class="intro-video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/3rsmBOKV5QQ"
        title="Mike Trounce — a quick introduction"
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>

    <ul class="jobs">
      {jobs.map((j) => (
        <li class="job">
          {j.href ? <a href={j.href}>{j.job}</a> : <span>{j.job}</span>}
            <span class="job-line">{j.line}</span>
        </li>
      ))}
    </ul>

    <section class="example">
      <Image class="example-photo" src={freddyPhoto} alt="Freddy Trounce, The Greensman, working in a client's garden" width={96} height={96} />
      <div>
        <h2>Stories</h2>
        <p>Freddy's garden and grounds business in Elstead was paying £125 a year to keep a website online, and handing out a flyer with the wrong web address on it. Neither needed a big project. They needed someone to notice.</p>
        <p class="example-link"><a href="/story-1">The Greensman, in full</a></p>
      </div>
    </section>

    <div class="sign-off">
      <Image class="face" src={mikePhoto} alt="Mike Trounce" width={184} height={282} loading="eager" />
      <p>
        Got something worth building? <a class="contact-email" href="mailto:trounceflow@gmail.com">trounceflow@gmail.com</a>
      </p>
    </div>
  </main>

  <footer class="site-footer">
    <nav>
      <a class="quiet" href="/about">About</a>
      <a class="quiet" href="/how-i-work">How I work</a>
      <a class="quiet" href="/stories">Stories</a>
      <a class="quiet" href="mailto:trounceflow@gmail.com">Contact</a>
    </nav>
  </footer>
</Layout>

<style>
  .home {
    max-width: 660px;
    margin: 0 auto;
    padding: clamp(3rem, 9vh, 5.5rem) 1.5rem 5rem;
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 clamp(2rem, 5vh, 3rem);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .role {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .lede {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 5.2vw, 2.9rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    max-width: 20ch;
    margin: 0 0 0.9rem;
  }

  .standfirst {
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
    max-width: 46ch;
    font-size: 1.08rem;
    color: var(--ink-soft);
  }

  /* ---------- intro video ---------- */
  .intro-video {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 16 / 9;
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 1px 2px rgba(var(--shadow) / 0.05), 0 18px 34px -18px rgba(var(--shadow) / 0.4);
  }
  .intro-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ---------- the list ---------- */
  .jobs {
    list-style: none;
    margin: 0 0 clamp(2.8rem, 6vh, 4rem);
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .job {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.6rem;
    line-height: 1.2;
  }
  .job a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .job a:hover {
    color: var(--green);
  }
.job-line { display: block; margin-top: 0.3rem; font-family: 'Figtree', system-ui, sans-serif; font-size: 1rem; line-height: 1.5; color: var(--ink-soft); }

  /* ---------- worked example + background ---------- */
  .example {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin: 0 0 clamp(2.2rem, 5vh, 3rem);
    max-width: 58ch;
  }
  .example-photo {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    object-position: 45% 20%;
  }
  .example h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .example p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .example-link {
    margin-top: 0.6rem;
  }
  .example-link a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--illus-a);
  }
  .example-link a:hover {
    color: var(--green);
  }

  /* ---------- sign-off ---------- */
  .sign-off {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: clamp(1.6rem, 4vh, 2.4rem);
    border-top: 1px solid var(--line);
  }
  .face {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 16%;
  }
  .sign-off p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .contact-email {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--illus-a);
  }
  .contact-email:hover {
    color: var(--green);
  }
  .quiet {
    font-size: 0.9rem;
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .quiet:hover {
    color: var(--ink-soft);
  }

.site-footer {
margin-top: clamp(1.6rem, 4vh, 2.2rem);
}
.site-footer nav {
display: flex;
gap: 1.25rem;
flex-wrap: wrap;
}

  @media (max-width: 560px) {
    .job {
      font-size: 1.35rem;
    }
  }
</style>
